PORT=3000
NODE_ENV=development

# No desenvolvimento, o sistema gera e guarda uma chave local automaticamente.
# Em produção, defina um segredo longo e aleatório.
# SESSION_SECRET=

# Opcional: crie uma conta administrativa inicial antes de abrir o site.
# Defina os dois para criar uma conta administrativa inicial.
# ADMIN_USER=
# ADMIN_PASSWORD=
# ADMIN_EMAIL=
